package liminal:controller@0.3.0;

interface admin-incoming {
  record workload {
    id: string,
    status: bool,
    name: string,
  }

  workloads: async func() -> list<workload>;
  stop: async func(id: string) -> bool;
  start: async func(name: string) -> bool;
}

world control {
  export admin-incoming;
}